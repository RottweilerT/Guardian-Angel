{
  "name": "guardian-angel",
  "version": "1.0.0",
  "private": true,
  "description": "Guardian Angel — l'ordinaire de la messe, les lectures du jour et des notes sur l'homélie (Firebase Hosting + Firestore).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-guardian --only firestore \"node --test tests/rules.spec.mjs\"",
    "check:lectures": "node scripts/import-lectures.mjs --check",
    "import:lectures": "node scripts/import-lectures.mjs",
    "emulators": "firebase emulators:start --project demo-guardian",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_PROJECT_ID=demo-guardian node scripts/import-lectures.mjs",
    "deploy": "firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase-admin": "^12.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.11.0"
  }
}
