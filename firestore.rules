rules_version = '2';
// Guardian Angel — règles de sécurité Firestore.
// Données privées (users/…) isolées des données publiques (missions publiées). Tout le reste est fermé.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Compte « réel » (Google) : les sessions anonymes ne servent qu'aux notifications.
    function isReal() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isOwner(uid) { return isReal() && request.auth.uid == uid; }
    function isAdmin() { return isReal() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function isDate(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Administrateurs : gérés à la main dans la console Firebase.
    match /admins/{uid} { allow get: if isOwner(uid); allow list, write: if false; }

    match /users/{uid} {
      // Consentement explicite (RGPD art. 9) — préalable à toute écriture de données spirituelles.
      match /meta/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'consent'
          && request.resource.data.keys().hasOnly(['version', 'givenAt', 'scope']) && request.resource.data.version is int;
      }
      function consented() { return exists(/databases/$(database)/documents/users/$(uid)/meta/consent); }

      match /journal/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && consented() && request.resource.data.id == id && isDate(request.resource.data.date)
          && request.resource.data.keys().hasOnly(['id', 'date', 'categorie', 'eglise', 'egliseId', 'notes', 'passages', 'reflexions', 'intentions', 'updatedAt'])
          && str(request.resource.data, 'categorie', 40) && str(request.resource.data, 'eglise', 200) && str(request.resource.data, 'egliseId', 40)
          && str(request.resource.data, 'notes', 20000) && str(request.resource.data, 'passages', 500)
          && str(request.resource.data, 'reflexions', 20000) && str(request.resource.data, 'intentions', 5000);
      }
      match /visits/{churchId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && consented() && request.resource.data.churchId == churchId && isDate(request.resource.data.date)
          && request.resource.data.keys().hasOnly(['churchId', 'nom', 'date', 'note', 'updatedAt'])
          && str(request.resource.data, 'nom', 200) && str(request.resource.data, 'note', 4000);
      }
      // Notes de la première version de l'application : lecture et suppression seulement.
      match /notes/{id} { allow read, delete: if isOwner(uid); allow create, update: if false; }
    }

    // Missions : lecture publique des missions publiées ; écriture réservée aux administrateurs.
    match /missions/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && request.resource.data.status in ['draft', 'published'];
      allow delete: if isAdmin();
    }

    // ---- Notifications push ----
    // Abonnement d'un appareil : privé (propriétaire seulement, y compris session anonyme). Jamais lisible publiquement.
    match /push_subscriptions/{id} {
      function validSub(d) {
        return d.keys().hasOnly(['uid', 'deviceId', 'kind', 'target', 'categories', 'active', 'createdAt', 'updatedAt'])
          && d.uid == request.auth.uid && id == request.auth.uid + '_' + d.deviceId
          && d.deviceId is string && d.deviceId.matches('^[a-z0-9]{8,32}$')
          && d.kind in ['fid', 'token'] && d.target is string && d.target.size() >= 10 && d.target.size() <= 4096
          && d.categories is list && d.categories.size() >= 1 && d.categories.size() <= 4
          && d.categories.hasOnly(['missions', 'liturgie', 'annonces', 'nouveautes'])
          && d.active is bool && d.updatedAt == request.time;
      }
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validSub(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && validSub(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Notifications : rédigées par un administrateur, envoyées par le serveur (Admin SDK, hors règles).
    match /notifications/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['title', 'body', 'category', 'url', 'source', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.status == 'pending' && request.resource.data.source == 'manuel'
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 65
        && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 180
        && request.resource.data.category in ['missions', 'liturgie', 'annonces', 'nouveautes']
        && request.resource.data.url is string && request.resource.data.url.matches('^/(#/[A-Za-z0-9_./%-]*)?$');
      // Seule action possible depuis le site : annuler un envoi qui n'a pas commencé.
      allow update: if isAdmin() && resource.data.status == 'pending' && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
    // Candidatures : chacun gère la sienne ; les administrateurs les lisent et en modifient le statut.
    match /applications/{id} {
      allow read: if (isReal() && resource.data.uid == request.auth.uid) || isAdmin();
      allow delete: if isReal() && resource.data.uid == request.auth.uid;
      allow create: if isReal() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.missionId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.status == 'published'
        && request.resource.data.keys().hasOnly(['uid', 'missionId', 'email', 'message', 'competences', 'disponibilites', 'status', 'createdAt'])
        && request.resource.data.status == 'envoyée'
        && str(request.resource.data, 'message', 2000) && str(request.resource.data, 'competences', 300) && str(request.resource.data, 'disponibilites', 300) && str(request.resource.data, 'email', 320);
      allow update: if isAdmin() && request.resource.data.uid == resource.data.uid;
    }
    // Signalements d'erreur sur une fiche d'église.
    match /reports/{id} {
      allow create: if isReal() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'churchId', 'churchName', 'message', 'status', 'createdAt'])
        && request.resource.data.status == 'nouveau' && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && str(request.resource.data, 'churchId', 40) && str(request.resource.data, 'churchName', 200);
      allow read, update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
